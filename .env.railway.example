# =====================================================================
# PADAXOR — Variaveis de Ambiente (Railway)
# Copie este arquivo como referencia ao configurar cada servico no Railway.
# NUNCA commitar o arquivo .env real com valores preenchidos.
# =====================================================================

# --- OBRIGATORIO: banco de dados (Railway Postgres) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- OBRIGATORIO: autenticacao do operador (Basic Auth — Onda 1) ---
# Minimo 24 caracteres. Gerado com: openssl rand -base64 32
ADMIN_USERNAME=drcaio
ADMIN_PASSWORD=TROCAR_PARA_SENHA_FORTE_DE_24_CHARS

# --- CORS: origens permitidas (virgula-separadas) ---
# Em producao no Railway: definir com o dominio real do frontend (padcom).
# Em dev no Replit: REPLIT_DOMAINS e lido automaticamente — nao precisa definir aqui.
# Obrigatorio apenas quando o dominio de producao NAO for *.replit.dev (ex.: dominio proprio).
ALLOWED_ORIGINS=https://padcom.railway.app,https://padaxor.railway.app

# --- OBRIGATORIO: sessao ---
# Gerado com: openssl rand -base64 64
SESSION_SECRET=gere-uma-string-aleatoria-de-64-caracteres-aqui

# --- OBRIGATORIO: API de cobranca (Asaas) ---
ASAAS_API_KEY=sua-chave-de-producao-asaas-aqui
ASAAS_WEBHOOK_TOKEN=token-para-validar-webhooks-asaas

# --- OBRIGATORIO: WhatsApp via Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OBRIGATORIO: Google Workspace (Service Account com Domain-Wide Delegation) ---
# Gerar com: cat chave.json | base64 -w 0
# Consulte: docs/GUIA_GOOGLE_SERVICE_ACCOUNT.md
GOOGLE_SERVICE_ACCOUNT_JSON=BASE64_DO_JSON_DA_SERVICE_ACCOUNT
GOOGLE_DELEGATED_EMAIL=drcaio@seudominio.com.br

# --- OPCIONAL: Object Storage S3-compativel (Cloudflare R2 recomendado) ---
S3_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=sua_chave_de_acesso
S3_SECRET_ACCESS_KEY=seu_segredo
S3_BUCKET_NAME=padaxor-storage
S3_REGION=auto

# --- OPCIONAL: assinatura digital ---
CERT_PATH=certs/assinatura.pfx
CERT_PASSWORD=senha-do-certificado

# --- OPCIONAL: ZapSign (assinatura eletronica) ---
ZAPSIGN_TOKEN=token-zapsign-producao
ZAPSIGN_BASE_URL=https://api.zapsign.com.br

# --- OPCIONAL: Telegram ---
TELEGRAM_BOT_TOKEN=token-do-bot-telegram

# --- LICENCIAMENTO (Onda 4) ---
# Deixar vazio na instancia do Dr. Caio (plataforma principal).
# Definir como "true" somente no clone de cada clinica licenciada.
IS_CLONE=

# --- AMBIENTE ---
NODE_ENV=production
LOG_LEVEL=info
PORT=8080

# =====================================================================
# VARIAVEIS DO api-worker (servico separado no Railway)
# =====================================================================

# Porta do health endpoint do worker (nao exposta publicamente).
WORKER_PORT=8081

# Todas as outras variaveis acima (DATABASE_URL, Google, Twilio, Asaas)
# devem ser replicadas no servico api-worker tambem.

# =====================================================================
# VARIAVEIS DO padcom (frontend admin — servico Vite estatico)
# =====================================================================

# URL publica do api-server no Railway (sem barra no final)
VITE_API_SERVER_URL=https://api-server-production.up.railway.app

PORT=3000
BASE_PATH=/

# =====================================================================
# NOTAS:
# 1. api-server e api-worker compartilham: DATABASE_URL, Google, Twilio.
# 2. api-worker: numReplicas=1 FIXO (nunca autoscalar — evita jobs duplicados).
# 3. Consulte docs/GUIA_GOOGLE_SERVICE_ACCOUNT.md para Service Account Google.
# 4. O ADMIN_PASSWORD protege TODAS as rotas do api-server exceto as publicas
#    listadas em src/middleware/basicAuth.ts (portal, anamnese, webhooks, health).
# =====================================================================
