# =====================================================================
# VARIAVEIS DE AMBIENTE — Railway
# Levantadas do codigo (process.env em artifacts/ e lib/), nao inventadas.
# =====================================================================


# =====================================================================
# SERVICO: @workspace/api-server
# =====================================================================

# --- OBRIGATORIO ---

# Banco de dados. lib/db/src/index.ts lanca erro no boot se estiver ausente.
# No Railway: "+ Add" > Database > PostgreSQL, depois referencie com
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Porta. artifacts/api-server/src/index.ts lanca erro no boot sem PORT.
PORT=8080

NODE_ENV=production

# Segredo HMAC dos tokens de portal do cliente e de colaborador
# (src/lib/portal-token.ts, src/lib/collaborator-auth.ts). Sem ele, os tokens
# sao assinados com uma chave aleatoria que muda a cada restart e todas as
# sessoes caem. Gere com: openssl rand -hex 32
SESSION_SECRET=

# Chave mestra do cofre de segredos cifrados (src/lib/secure-settings.ts).
# OBRIGATORIA em producao — sem ela, gravar/ler o cofre falha.
# Gere com: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# --- OPCIONAL: credenciais que tambem podem ficar no cofre (Configuracoes) ---
# O codigo le primeiro do cofre no banco e so cai para o env como fallback
# (src/lib/secure-settings.ts, src/lib/integration-registry.ts).

# Cobranca Asaas
ASAAS_API_KEY=
ASAAS_BASE_URL=

# Twilio (WhatsApp / SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# WHATSAPP_FROM e o nome legado, ainda aceito como ultima opcao
WHATSAPP_FROM=

# Assinatura eletronica — ZapSign
ZAPSIGN_API_TOKEN=
ZAPSIGN_TOKEN=
ZAPSIGN_BASE_URL=https://api.zapsign.com.br
ZAPSIGN_BRAND_NAME=
ZAPSIGN_WEBHOOK_SECRET=
ZAPSIGN_WEBHOOK_SECRET_NEXT=

# Assinatura eletronica — ClickSign
CLICKSIGN_TOKEN=
CLICKSIGN_BASE_URL=
CLICKSIGN_WEBHOOK_SECRET=

# Assinatura digital com certificado A1 (.pfx)
CERT_PATH=
CERT_PASSWORD=

# IA
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
AI_INTEGRATIONS_GEMINI_API_KEY=
OPENAI_API_KEY=

# Notificacoes e identificacao
ADMIN_EMAIL=
CEO_EMAIL=
CEO_WHATSAPP=
CLINIC_EMAIL=
SNCR_ALERT_EMAIL=
TELEGRAM_BOT_TOKEN=

# Dados do medico responsavel (documentos)
MEDICO_NOME=
MEDICO_CPF=
MEDICO_EMAIL=

# Trello (quadro operacional)
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# Log
LOG_LEVEL=info


# =====================================================================
# SERVICO: @workspace/padcom (frontend admin)
# =====================================================================

PORT=3000

# URL publica do api-server no Railway, SEM barra no final.
# O "vite preview" faz proxy de /api para este destino (vite.config.ts).
# Pode usar a referencia do Railway:
#   VITE_API_SERVER_URL=https://${{api-server.RAILWAY_PUBLIC_DOMAIN}}
VITE_API_SERVER_URL=


# =====================================================================
# SERVICO: @workspace/parxis-site (site publico)
# =====================================================================

PORT=3000
# Nao precisa de mais nada: e estatico e nao fala com o api-server.


# =====================================================================
# LIMITACAO CONHECIDA — integracoes Google
# =====================================================================
# Agenda, Gmail e Drive (src/lib/google-calendar.ts, google-gmail.ts,
# google-drive.ts) autenticam pelo Replit Connectors, lendo
# REPLIT_CONNECTORS_HOSTNAME e REPL_IDENTITY. Essas variaveis so existem
# dentro do Replit — no Railway essas tres integracoes ficam indisponiveis
# ate serem reescritas para OAuth proprio do Google. Nao ha variavel de
# ambiente que resolva isso.
