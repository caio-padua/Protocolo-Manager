# =====================================================================
# VARIAVEIS DE AMBIENTE — Railway (api-server)
# Copie este arquivo como referencia ao configurar cada servico no Railway
#
# Os nomes abaixo foram conferidos no codigo. Variavel com nome errado nao
# da erro: a funcionalidade so fica silenciosamente desligada.
# =====================================================================

# ---------------------------------------------------------------------
# OBRIGATORIAS NO BOOT — sem qualquer uma destas o processo NAO SOBE.
# Sao validadas na importacao dos modulos: o conteiner entra em
# crash-loop antes de escutar a porta.
# ---------------------------------------------------------------------

DATABASE_URL=postgresql://user:password@host:5432/dbname

# Gateway de IA — no Railway aponte para as APIs oficiais e use suas chaves.
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com
AI_INTEGRATIONS_ANTHROPIC_API_KEY=sua-chave-anthropic
AI_INTEGRATIONS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
AI_INTEGRATIONS_GEMINI_API_KEY=sua-chave-gemini

# ---------------------------------------------------------------------
# AMBIENTE
# PORT e injetada automaticamente pelo Railway — nao precisa criar.
# ---------------------------------------------------------------------

NODE_ENV=production
PORT=8080

# ---------------------------------------------------------------------
# SESSAO E COFRE DE SEGREDOS
# Gere cada uma com:  openssl rand -hex 32
#
# APP_ENCRYPTION_KEY e a chave-mestra do cofre cifrado. Com
# NODE_ENV=production ela passa a ser OBRIGATORIA para ler ou gravar
# qualquer segredo do cofre (Asaas, ZapSign, Twilio) — sem ela essas
# telas falham. Guarde-a: trocar a chave torna ilegiveis os segredos
# ja gravados.
# ---------------------------------------------------------------------

SESSION_SECRET=gere-uma-string-aleatoria-de-64-caracteres-aqui
APP_ENCRYPTION_KEY=gere-outra-string-aleatoria-de-64-caracteres-aqui

# ---------------------------------------------------------------------
# INTEGRACOES — opcionais, a aplicacao sobe sem elas.
# Todas podem ser preenchidas depois pela tela de configuracoes, que
# grava no cofre cifrado. O env serve como valor inicial.
# ---------------------------------------------------------------------

# --- Cobranca (Asaas) ---
ASAAS_API_KEY=sua-chave-de-producao-asaas-aqui
ASAAS_WEBHOOK_TOKEN=token-para-validar-webhooks-asaas
# ASAAS_BASE_URL ja tem padrao de producao; defina so para sandbox.

# --- WhatsApp / SMS (Twilio) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Assinatura eletronica (ZapSign) ---
# ZAPSIGN_API_TOKEN e o nome oficial; ZAPSIGN_TOKEN tambem e aceito (legado).
ZAPSIGN_API_TOKEN=token-zapsign-producao
ZAPSIGN_BASE_URL=https://api.zapsign.com.br

# --- Assinatura digital com certificado A1 ---
CERT_PATH=certs/assinatura.pfx
CERT_PASSWORD=senha-do-certificado

# --- Telegram ---
TELEGRAM_BOT_TOKEN=token-do-bot-telegram

# --- Destinatarios de notificacao ---
ADMIN_EMAIL=
CEO_EMAIL=
CLINIC_EMAIL=

# --- Trello ---
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# --- Log ---
LOG_LEVEL=info

# ---------------------------------------------------------------------
# GOOGLE (Drive, Gmail, Calendar) — LEIA ANTES DE CONFIGURAR
#
# Estas funcionalidades NAO usam OAuth proprio neste codigo. As
# credenciais vem do gateway de conectores do Replit, via
# REPLIT_CONNECTORS_HOSTNAME + REPL_IDENTITY. Fora do Replit as chamadas
# falham com "X-Replit-Token not found".
#
# Por isso GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET e GOOGLE_REDIRECT_URI
# NAO EXISTEM no codigo — defini-las no Railway nao tem efeito nenhum.
#
# Para usar Drive/Gmail/Calendar no Railway e preciso portar
# lib/google-drive.ts, google-gmail.ts e google-calendar.ts para OAuth
# padrao do Google (client id/secret + refresh token). Enquanto isso nao
# for feito, essas telas ficam indisponiveis e o drive-watcher registra
# erro no log a cada 5 minutos — e ruido esperado, nao quebra o servidor.
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# PUPPETEER (captura PNG do receituario)
# O caminho do Chromium e resolvido por ambiente: PUPPETEER_EXECUTABLE_PATH
# tem prioridade, depois o Chromium do Nix (so existe no Replit) e por fim
# o Chromium que o proprio puppeteer baixa. Para essa tela funcionar no
# Railway, instale o Chromium na imagem e aponte a variavel.
# ---------------------------------------------------------------------

# NIXPACKS_PKGS=chromium
# PUPPETEER_EXECUTABLE_PATH=/nix/var/nix/profiles/default/bin/chromium

# =====================================================================
# VARIAVEIS DE AMBIENTE — Railway (padcom — frontend admin)
#
# O padcom chama a API por caminho relativo (/api/...) e a sessao e por
# cookie. O servidor de preview do Vite encaminha /api para o destino
# abaixo, mantendo tudo na mesma origem.
# =====================================================================

# URL publica do api-server no Railway (sem barra no final)
VITE_API_SERVER_URL=https://api-server-production.up.railway.app

PORT=3000
BASE_PATH=/

# =====================================================================
# VARIAVEIS DE AMBIENTE — Railway (parxis-site — site institucional)
# =====================================================================

# PORT=3000
# BASE_PATH=/
