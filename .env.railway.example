# =====================================================================
# VARIAVEIS DE AMBIENTE — Railway (api-server)
# Copie este arquivo como referencia ao configurar cada servico no Railway
# =====================================================================

# --- OBRIGATORIO: banco de dados ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- OBRIGATORIO: sessao ---
SESSION_SECRET=gere-uma-string-aleatoria-de-64-caracteres-aqui

# --- OBRIGATORIO: API de cobranca ---
ASAAS_API_KEY=sua-chave-de-producao-asaas-aqui
ASAAS_WEBHOOK_TOKEN=token-para-validar-webhooks-asaas

# --- OBRIGATORIO: WhatsApp / SMS ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OBRIGATORIO: Google (agenda, e-mail, drive) ---
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=https://SEU-DOMINIO-RAILWAY.railway.app/api/google/callback

# --- OPCIONAL: assinatura digital ---
CERT_PATH=certs/assinatura.pfx
CERT_PASSWORD=senha-do-certificado

# --- OPCIONAL: ZapSign (assinatura eletronica) ---
ZAPSIGN_TOKEN=token-zapsign-producao
ZAPSIGN_BASE_URL=https://api.zapsign.com.br

# --- OPCIONAL: Telegram ---
TELEGRAM_BOT_TOKEN=token-do-bot-telegram

# --- AMBIENTE ---
NODE_ENV=production
PORT=8080

# =====================================================================
# VARIAVEIS DE AMBIENTE — Railway (padcom — frontend admin)
# =====================================================================

# URL publica do api-server no Railway (sem barra no final)
# Exemplo: https://api-server-production.up.railway.app
VITE_API_SERVER_URL=https://api-server-production.up.railway.app

PORT=3000
BASE_PATH=/
