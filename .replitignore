# The format of this file is identical to `.dockerignore`.
# It is used to reduce the size of deployed images to make the process of publishing faster.

# No need to store the pnpm store twice.
.local

# Relatorios gerados nao fazem parte da aplicacao publicada.
generated-artifacts

# Anexos enviados pelo CEO (1,3 GB) e cache local (1,6 GB): nenhum codigo publicado le esses
# arquivos (verificado: sem imports de @assets; so scripts de prova e testes citam attached_assets).
attached_assets
.cache
