# =====================================================================
# api-server — Variáveis de Ambiente (Railway)
# Copie este arquivo como referência ao configurar o serviço no Railway.
# NUNCA commitar o arquivo .env real com valores preenchidos.
#
# Arquivo completo de todas as variáveis do projeto (api-server + worker):
# ver .env.railway.example na raiz do repositório.
# =====================================================================

# --- OBRIGATÓRIO: banco de dados (Railway Postgres) ---
DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- OBRIGATÓRIO: sessão ---
# Gerado com: openssl rand -base64 64
SESSION_SECRET=gere-uma-string-aleatoria-de-64-caracteres-aqui

# --- CORS: origens permitidas (vírgula-separadas) ---
# Em dev no Replit: REPLIT_DOMAINS é lida automaticamente — não precisa definir aqui.
# Em produção com domínio próprio (ex.: Railway): definir com o domínio real do frontend.
# Formato: https://app.clinica.com.br,https://www.clinica.com.br
# Quando ausente, o servidor usa REPLIT_DOMAINS (injetada pela plataforma).
ALLOWED_ORIGINS=https://padcom.railway.app,https://padaxor.railway.app

# --- OBRIGATÓRIO: autenticação do operador (Basic Auth) ---
ADMIN_USERNAME=drcaio
ADMIN_PASSWORD=TROCAR_PARA_SENHA_FORTE_DE_24_CHARS

# --- OBRIGATÓRIO: API de cobrança (Asaas) ---
ASAAS_API_KEY=sua-chave-de-producao-asaas-aqui
ASAAS_WEBHOOK_TOKEN=token-para-validar-webhooks-asaas

# --- OBRIGATÓRIO: WhatsApp via Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OBRIGATÓRIO: Google Workspace ---
GOOGLE_SERVICE_ACCOUNT_JSON=BASE64_DO_JSON_DA_SERVICE_ACCOUNT
GOOGLE_DELEGATED_EMAIL=drcaio@seudominio.com.br

# --- OBRIGATÓRIO: Object Storage (Replit) ---
DEFAULT_OBJECT_STORAGE_BUCKET_ID=seu-bucket-id
PRIVATE_OBJECT_DIR=gs://seu-bucket/private
PUBLIC_OBJECT_SEARCH_PATHS=gs://seu-bucket/public

# --- OPCIONAL: Telegram ---
TELEGRAM_BOT_TOKEN=token-do-bot-telegram

# --- OPCIONAL: assinatura digital ---
CERT_PASSWORD=senha-do-certificado

# --- AMBIENTE ---
NODE_ENV=production
LOG_LEVEL=info
PORT=8080
