# Variáveis de ambiente para deploy no Railway — padcom
# Copie este arquivo para .env no ambiente de produção e preencha os valores reais.

# ──────────────────────────────────────────────────────────────────────────────
# URL da Área do Paciente (obrigatória em produção)
# Preencha com o endereço público completo da Área do Paciente,
# incluindo o caminho /area. Exemplo: https://app.seudominio.com.br/area
# Sem esta variável, o Guia Digital usa window.location.origin como fallback
# (funciona se o guia e a área estiverem no mesmo domínio, mas não em multi-tenant).
VITE_AREA_URL=https://app.seudominio.com.br/area
